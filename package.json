{
  "name": "freightlink",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @freightlink/api",
    "dev:web": "npm run dev --workspace @freightlink/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace @freightlink/api",
    "test:db": "npm run test:db --workspace @freightlink/api",
    "typecheck": "npm run typecheck --workspaces",
    "db:validate": "npm run db:validate --workspace @freightlink/api",
    "db:deploy": "npm run db:deploy --workspace @freightlink/api"
  }
}
