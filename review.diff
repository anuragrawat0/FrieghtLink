index 0000000..1431f8a
--- /dev/null
+++ b/apps/api/test/foundation/web-flow.browser.mjs
@@ -0,0 +1,194 @@
+// Run with node --test against the isolated database and a Next.js dev server.
+// Install Playwright separately or set PLAYWRIGHT_MODULE to its local entry point.
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+
+const origin = new URL(process.env.TEST_WEB_ORIGIN ?? "http://localhost:4310");
+const adminEmail = process.env.DEMO_ADMIN_EMAIL;
+const adminPassword = process.env.DEMO_ADMIN_PASSWORD;
+const certificate = Buffer.from("%PDF-1.7\nFreightLink browser test certificate\n%%EOF\n");
+
+test("StrictMode carrier verification, certificate download and load lifecycle", { timeout: 120_000 }, async () => {
+  assert.ok(["localhost", "127.0.0.1"].includes(origin.hostname), "Use a local browser test stack.");
+  assert.ok(adminEmail && adminPassword, "Seed a test admin and set its credentials for the browser test.");
+  const { chromium } = await import(process.env.PLAYWRIGHT_MODULE ?? "playwright");
+  const browser = await chromium.launch({ executablePath: process.env.BROWSER_EXECUTABLE_PATH });
+  const errors = [];
+
+  async function session() {
+    const page = await browser.newPage();
+    page.setDefaultTimeout(12_000);
+    await page.addInitScript(() => {
+      window.freightlinkUnhandledRejections = [];
+      window.addEventListener("unhandledrejection", (event) => {
+        window.freightlinkUnhandledRejections.push(String(event.reason));
+      });
+    });
+    page.on("pageerror", (error) => errors.push(`${error.name}: ${error.message}`));
+    page.on("console", (message) => {
+      if (message.type() === "error" && /AbortError|hydration|unhandled/i.test(message.text())) errors.push(message.text());
+    });
+    return page;
+  }
+
+  const tag = randomUUID().slice(0, 8);
+  const carrierName = `Test Carrier ${tag}`;
+  const loadName = `Pallets ${tag}`;
+  const revisedName = `Revised ${loadName}`;
+
+  async function register(page, name, role) {
+    await page.goto(new URL("/register", origin).href);
+    await page.getByLabel("Display name").fill(name);
+    await page.getByLabel("Email").fill(`${role.toLowerCase()}-${tag}@example.test`);
+    await page.getByLabel("Password").fill(`Browser smoke ${tag}!`);
+    await page.getByLabel("Account type").selectOption(role);
+    await page.getByRole("button", { name: "Create an account" }).click();
+    await page.getByText(`Signed in as ${name}.`).waitFor();
+  }
+
+  try {
+    const carrier = await session();
+    const admin = await session();
+    const shipper = await session();
+
+    await register(carrier, carrierName, "CARRIER");
+    await carrier.addInitScript(() => {
+      const probe = { calls: 0, rejected: 0, rejectNext: false, slowPath: null, started: 0, aborted: 0 };
+      window.freightlinkSessionProbe = probe;
+      const fetch = window.fetch.bind(window);
+      window.fetch = (resource, options) => {
+        const path = typeof resource === "string" ? new URL(resource, location.href).pathname : null;
+        if (probe.slowPath && path === probe.slowPath) {
+          probe.started++;
+          const stream = new ReadableStream({
+            start(controller) {
+              controller.enqueue(new TextEncoder().encode('{"data":'));
+              options?.signal?.addEventListener("abort", () => {
+                probe.aborted++;
+                controller.error(options.signal.reason);
+              }, { once: true });
+            },
+          });
+          return Promise.resolve(new Response(stream));
+        }
+        if (path === "/api/v1/users/me") {
+          probe.calls++;
+          if (probe.calls === 1 || probe.calls === 3 || probe.rejectNext) {
+            probe.rejectNext = false;
+            probe.rejected++;
+            return Promise.reject(new DOMException("Browser test interruption", "AbortError"));
+          }
+        }
+        return fetch(resource, options);
+      };
+    });
+    await carrier.goto(new URL("/carrier", origin).href);
+    // Without StrictMode's second effect setup, the deliberately aborted initial read leaves this page loading.
+    await carrier.getByRole("heading", { name: "Carrier verification" }).waitFor();
+    // The two initial setups are followed by the first socket connect callback.
+    await carrier.waitForFunction(() => window.freightlinkSessionProbe.rejected === 2);
+    await carrier.evaluate(() => {
+      window.freightlinkSessionProbe.rejectNext = true;
+      window.dispatchEvent(new Event("focus"));
+    });
+    await carrier.waitForFunction(() => window.freightlinkSessionProbe.rejected === 3);
+
+    // Hold a session response open, then let a second focus event replace it.
+    await carrier.evaluate(() => {
+      window.freightlinkSessionProbe.slowPath = "/api/v1/users/me";
+      window.dispatchEvent(new Event("focus"));
+    });
+    await carrier.waitForFunction(() => window.freightlinkSessionProbe.started === 1);
+    const sessionResponse = carrier.waitForResponse((response) => new URL(response.url()).pathname === "/api/v1/users/me" && response.ok());
+    await carrier.evaluate(() => {
+      window.freightlinkSessionProbe.slowPath = null;
+      window.dispatchEvent(new Event("focus"));
+    });
+    await sessionResponse;
+    await carrier.waitForFunction(() => window.freightlinkSessionProbe.aborted === 1);
+    await carrier.getByLabel("Motor carrier license").fill(`MC-${tag}`);
+    await carrier.getByLabel("Safety rating").selectOption("SATISFACTORY");
+    await carrier.getByRole("button", { name: "Save profile" }).click();
+    await carrier.getByLabel("Insurance certificate").setInputFiles({ name: "insurance.pdf", mimeType: "application/pdf", buffer: certificate });
+    await carrier.getByRole("button", { name: "Upload certificate" }).click();
+    await carrier.getByText(/Insurance uploaded/).waitFor();
+    await carrier.getByRole("button", { name: "Submit for review" }).click();
+    await carrier.getByRole("status").filter({ hasText: "Pending review" }).waitFor();
+
+    await admin.goto(new URL("/login", origin).href);
+    await admin.getByLabel("Email").fill(adminEmail);
+    await admin.getByLabel("Password").fill(adminPassword);
+    await admin.getByRole("button", { name: "Sign in" }).click();
+    await admin.getByRole("link", { name: "Pending carrier reviews" }).click();
+    await admin.getByRole("link", { name: carrierName }).click();
+    const [download] = await Promise.all([
+      admin.waitForEvent("download"), admin.getByRole("button", { name: "Download certificate" }).click(),
+    ]);
+    assert.equal(download.suggestedFilename(), "insurance.pdf");
+    assert.deepEqual(await readFile(await download.path()), certificate);
+    await admin.getByRole("button", { name: "Approve carrier" }).click();
+    await admin.getByRole("status").filter({ hasText: "Approved" }).waitFor();
+    await carrier.getByRole("status").filter({ hasText: "Approved" }).waitFor();
+
+    const shipperName = `Test Shipper ${tag}`;
+    await register(shipper, shipperName, "SHIPPER");
+    await shipper.getByRole("link", { name: "Your loads" }).click();
+    await shipper.getByLabel("Description").fill(loadName);
+    const dateTime = (hours) => new Date(Date.now() + hours * 3_600_000).toISOString().slice(0, 16);
+    for (const [stop, city, state, lat, lng] of [
+      ["pickup", "Columbus", "OH", "39.96", "-83.00"],
+      ["delivery", "Indianapolis", "IN", "39.77", "-86.16"],
+    ]) {
+      for (const [field, value] of [["City", city], ["Region", state], ["Lat", lat], ["Lng", lng]]) {
+        await shipper.locator(`[name="${stop}${field}"]`).fill(value);
+      }
+    }
+    await shipper.getByLabel("Ready at (local time)").fill(dateTime(48));
+    await shipper.getByLabel("Deliver by (local time)").fill(dateTime(72));
+    await shipper.getByRole("button", { name: "Create draft" }).click();
+    await shipper.getByText(`${loadName} (DRAFT)`, { exact: true }).waitFor();
+    await shipper.getByLabel("Description").fill(revisedName);
+    await shipper.getByRole("button", { name: "Save changes" }).click();
+    await shipper.getByText(`${revisedName} (DRAFT)`, { exact: true }).waitFor();
+    await shipper.getByRole("button", { name: "Publish load" }).click();
+    await shipper.getByText(`${revisedName} (OPEN)`, { exact: true }).waitFor();
+
+    await carrier.getByRole("link", { name: "Browse loads" }).click();
+    await carrier.getByRole("link", { name: revisedName }).click();
+    await carrier.getByText(`${revisedName} (OPEN)`, { exact: true }).waitFor();
+    await shipper.getByRole("button", { name: "Cancel load" }).click();
+    await shipper.getByText(`${revisedName} (CANCELLED)`, { exact: true }).waitFor();
+    await carrier.getByRole("link", { name: "Open loads" }).click();
+    await carrier.getByText("No open loads on this page.").waitFor();
+
+    // Leave the load list while its GET is still reading a response body.
+    await carrier.getByRole("link", { name: "Carrier home" }).click();
+    await carrier.getByRole("heading", { name: "Carrier verification" }).waitFor();
+    await carrier.evaluate(() => { window.freightlinkSessionProbe.slowPath = "/api/v1/loads"; });
+    await carrier.getByRole("link", { name: "Browse loads" }).click();
+    await carrier.waitForFunction(() => {
+      const { started, aborted } = window.freightlinkSessionProbe;
+      return started > aborted;
+    });
+    await carrier.getByRole("link", { name: "Carrier home" }).click();
+    await carrier.getByRole("heading", { name: "Carrier verification" }).waitFor();
+    await carrier.waitForFunction(() => {
+      const { started, aborted } = window.freightlinkSessionProbe;
+      return started >= 2 && started === aborted;
+    });
+    await carrier.getByRole("link", { name: "Sign out" }).click();
+    await carrier.getByRole("heading", { name: "Sign out" }).waitFor();
+    await carrier.getByRole("button", { name: "Sign out" }).click();
+    await carrier.getByRole("heading", { name: "Sign in" }).waitFor();
+
+    for (const page of [carrier, admin, shipper]) {
+      assert.deepEqual(await page.evaluate(() => window.freightlinkUnhandledRejections), []);
+      assert.equal(await page.locator("[data-nextjs-dialog-overlay], [data-nextjs-toast-errors]").count(), 0);
+    }
+    assert.deepEqual(errors, []);
+  } finally {
+    await browser.close();
+  }
+});
diff --git a/apps/api/test/loads/loads.access.integration.test.ts b/apps/api/test/loads/loads.access.integration.test.ts
new file mode 100644
index 0000000..b401e13
--- /dev/null
+++ b/apps/api/test/loads/loads.access.integration.test.ts
@@ -0,0 +1,205 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, expect, it } from "vitest";
+import { buildApp } from "../../src/app.js";
+import { readConfig } from "../../src/config.js";
+import type { Role } from "../../src/generated/prisma/client.js";
+import { requireTestDatabaseUrl } from "../setup/database.js";
+
+const prefix = `loads-access-${randomUUID()}-`;
+const loadsUrl = "/api/v1/loads";
+let app: ReturnType<typeof buildApp>;
+let shipper: Account;
+let otherShipper: Account;
+let admin: Account;
+let carrier: Account;
+let openLoadId: string;
+let draftLoadId: string;
+let cancelLoadId: string;
+let assignedLoadId: string;
+
+type Account = {
+  id: string;
+  headers: { authorization: string };
+  profileId?: string;
+};
+
+beforeAll(async () => {
+  app = buildApp(readConfig({
+    NODE_ENV: "test", DATABASE_URL: requireTestDatabaseUrl(), JWT_SECRET: randomUUID(),
+  }));
+  await app.ready();
+
+  shipper = await account("SHIPPER", "shipper");
+  otherShipper = await account("SHIPPER", "other-shipper");
+  admin = await account("ADMIN", "admin");
+  carrier = await account("CARRIER", "carrier");
+
+  openLoadId = await createLoad("open");
+  draftLoadId = await createLoad("draft");
+  cancelLoadId = await createLoad("cancel");
+  assignedLoadId = await createLoad("assigned");
+  await publish(openLoadId);
+  await publish(cancelLoadId);
+  await app.prisma.load.update({ where: { id: assignedLoadId }, data: { status: "ASSIGNED" } });
+});
+
+afterAll(async () => {
+  try {
+    if (app?.prisma) {
+      const email = { startsWith: prefix };
+      await app.prisma.bid.deleteMany({ where: { load: { shipper: { email } } } });
+      await app.prisma.load.deleteMany({ where: { shipper: { email } } });
+      await app.prisma.carrierProfile.deleteMany({ where: { user: { email } } });
+      await app.prisma.user.deleteMany({ where: { email } });
+    }
+  } finally {
+    await app?.close();
+  }
+});
+
+async function account(role: Role, name: string): Promise<Account> {
+  const user = await app.prisma.user.create({
+    data: { email: `${prefix}${name}@example.test`, displayName: name, role, passwordHash: "fixture" },
+  });
+  const profile = role === "CARRIER" ? await app.prisma.carrierProfile.create({ data: { userId: user.id } }) : undefined;
+  return {
+    id: user.id,
+    headers: { authorization: `Bearer ${await app.auth.signAccessToken(user.id)}` },
+    profileId: profile?.id,
+  };
+}
+
+function loadInput(overrides: Record<string, unknown> = {}) {
+  const now = Date.now();
+  return {
+    description: "Access probe",
+    pickupCity: "Columbus", pickupRegion: "OH", pickupLat: 39.96, pickupLng: -83.0,
+    deliveryCity: "Indianapolis", deliveryRegion: "IN", deliveryLat: 39.77, deliveryLng: -86.16,
+    pickupReadyAt: new Date(now + 3_600_000).toISOString(),
+    deliveryBy: new Date(now + 7_200_000).toISOString(),
+    ...overrides,
+  };
+}
+
+async function createLoad(name: string, overrides: Record<string, unknown> = {}) {
+  const response = await app.inject({
+    method: "POST", url: loadsUrl, headers: shipper.headers, payload: loadInput({ description: name, ...overrides }),
+  });
+  expect(response.statusCode, response.body).toBe(201);
+  return response.json().data.id as string;
+}
+
+async function publish(id: string) {
+  const response = await app.inject({ method: "POST", url: `${loadsUrl}/${id}/publish`, headers: shipper.headers });
+  expect(response.statusCode, response.body).toBe(200);
+}
+
+async function approveCarrier() {
+  await app.prisma.carrierProfile.update({
+    where: { id: carrier.profileId! }, data: { verificationStatus: "APPROVED" },
+  });
+}
+
+it("authenticates before parsing an invalid body", async () => {
+  const response = await app.inject({
+    method: "POST", url: loadsUrl, headers: { "content-type": "application/json" }, payload: "{",
+  });
+  expect(response.statusCode).toBe(401);
+  expect(response.json().error.code).toBe("UNAUTHENTICATED");
+});
+
+it("denies an unapproved carrier on list and read", async () => {
+  const list = await app.inject({ url: loadsUrl, headers: carrier.headers });
+  expect(list.statusCode).toBe(403);
+  expect(list.json().error.code).toBe("CARRIER_NOT_APPROVED");
+
+  const read = await app.inject({ url: `${loadsUrl}/${openLoadId}`, headers: carrier.headers });
+  expect(read.statusCode).toBe(404);
+  expect(read.json().error.code).toBe("NOT_FOUND");
+});
+
+it("grants an approved carrier immediate access to open loads", async () => {
+  await approveCarrier();
+  const list = await app.inject({ url: loadsUrl, headers: carrier.headers });
+  expect(list.statusCode).toBe(200);
+  expect(list.json().data).toContainEqual(expect.objectContaining({ id: openLoadId, status: "OPEN" }));
+
+  const read = await app.inject({ url: `${loadsUrl}/${openLoadId}`, headers: carrier.headers });
+  expect(read.statusCode).toBe(200);
+  expect(read.json().data.id).toBe(openLoadId);
+});
+
+it("keeps drafts and other shippers' loads out of a carrier's scope", async () => {
+  await approveCarrier();
+  const read = await app.inject({ url: `${loadsUrl}/${draftLoadId}`, headers: carrier.headers });
+  expect(read.statusCode).toBe(404);
+
+  const list = await app.inject({ url: `${loadsUrl}?status=DRAFT`, headers: carrier.headers });
+  expect(list.statusCode).toBe(200);
+  expect(list.json().data).toEqual([]);
+});
+
+it("hides another shipper's loads from reads and edits", async () => {
+  const read = await app.inject({ url: `${loadsUrl}/${openLoadId}`, headers: otherShipper.headers });
+  expect(read.statusCode).toBe(404);
+
+  const patch = await app.inject({
+    method: "PATCH", url: `${loadsUrl}/${openLoadId}`, headers: otherShipper.headers,
+    payload: { description: "hijacked" },
+  });
+  expect(patch.statusCode).toBe(404);
+  expect((await app.prisma.load.findUnique({ where: { id: openLoadId } }))?.description).toBe("open");
+});
+
+it("rejects invalid regions, coordinates and schedules", async () => {
+  const base = loadInput();
+  const region = await app.inject({
+    method: "POST", url: loadsUrl, headers: shipper.headers, payload: { ...base, pickupRegion: "ZZ" },
+  });
+  expect(region.statusCode).toBe(400);
+
+  const latitude = await app.inject({
+    method: "POST", url: loadsUrl, headers: shipper.headers, payload: { ...base, pickupLat: 91 },
+  });
+  expect(latitude.statusCode).toBe(400);
+
+  const longitude = await app.inject({
+    method: "POST", url: loadsUrl, headers: shipper.headers, payload: { ...base, deliveryLng: -181 },
+  });
+  expect(longitude.statusCode).toBe(400);
+
+  const equalSchedule = await app.inject({
+    method: "POST", url: loadsUrl, headers: shipper.headers, payload: { ...base, deliveryBy: base.pickupReadyAt },
+  });
+  expect(equalSchedule.statusCode).toBe(422);
+  expect(equalSchedule.json().error.code).toBe("INVALID_LOAD_SCHEDULE");
+
+  const now = Date.now();
+  const past = await app.inject({
+    method: "POST", url: loadsUrl, headers: shipper.headers,
+    payload: loadInput({
+      pickupReadyAt: new Date(now - 7_200_000).toISOString(),
+      deliveryBy: new Date(now - 3_600_000).toISOString(),
+    }),
+  });
+  expect(past.statusCode).toBe(201);
+  const publishPast = await app.inject({
+    method: "POST", url: `${loadsUrl}/${past.json().data.id}/publish`, headers: shipper.headers,
+  });
+  expect(publishPast.statusCode).toBe(422);
+  expect(publishPast.json().error.code).toBe("INVALID_LOAD_SCHEDULE");
+});
+
+it("replays cancellation and refuses to cancel an assigned load", async () => {
+  const first = await app.inject({ method: "POST", url: `${loadsUrl}/${cancelLoadId}/cancel`, headers: shipper.headers });
+  expect(first.statusCode).toBe(200);
+  expect(first.json().data.status).toBe("CANCELLED");
+
+  const second = await app.inject({ method: "POST", url: `${loadsUrl}/${cancelLoadId}/cancel`, headers: shipper.headers });
+  expect(second.statusCode).toBe(200);
+  expect(second.json().data).toEqual(first.json().data);
+
+  const assigned = await app.inject({ method: "POST", url: `${loadsUrl}/${assignedLoadId}/cancel`, headers: shipper.headers });
+  expect(assigned.statusCode).toBe(409);
+  expect(assigned.json().error.code).toBe("LOAD_NOT_CANCELLABLE");
+});
diff --git a/apps/api/test/loads/loads.integration.test.ts b/apps/api/test/loads/loads.integration.test.ts
new file mode 100644
index 0000000..6301fff
--- /dev/null
+++ b/apps/api/test/loads/loads.integration.test.ts
@@ -0,0 +1,112 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+import { buildApp } from "../../src/app.js";
+import { readConfig } from "../../src/config.js";
+import type { Role } from "../../src/generated/prisma/client.js";
+import { requireTestDatabaseUrl } from "../setup/database.js";
+
+const prefix = `loads-${randomUUID()}-`;
+const url = "/api/v1/loads";
+let app: ReturnType<typeof buildApp>;
+
+beforeAll(async () => {
+  app = buildApp(readConfig({ NODE_ENV: "test", DATABASE_URL: requireTestDatabaseUrl(), JWT_SECRET: randomUUID() }));
+  await app.ready();
+});
+
+afterAll(async () => {
+  if (!app) return;
+  try {
+    if (app.prisma) {
+      const email = { startsWith: prefix };
+      await app.prisma.bid.deleteMany({ where: { load: { shipper: { email } } } });
+      await app.prisma.load.deleteMany({ where: { shipper: { email } } });
+      await app.prisma.carrierProfile.deleteMany({ where: { user: { email } } });
+      await app.prisma.user.deleteMany({ where: { email } });
+    }
+  } finally {
+    await app.close();
+  }
+});
+
+async function account(role: Role, name: string) {
+  const user = await app.prisma.user.create({ data: { email: `${prefix}${name}@example.test`, role, displayName: name, passwordHash: "fixture" } });
+  const profile = role === "CARRIER" ? await app.prisma.carrierProfile.create({ data: { userId: user.id } }) : undefined;
+  return { id: user.id, headers: { authorization: `Bearer ${await app.auth.signAccessToken(user.id)}` }, profileId: profile?.id };
+}
+
+it("scopes load access, validates schedules and closes active bids atomically without replay events", async () => {
+  const shipper = await account("SHIPPER", "shipper");
+  const otherShipper = await account("SHIPPER", "other");
+  const admin = await account("ADMIN", "admin");
+  const bidder = await account("CARRIER", "bidder");
+  const observer = await account("CARRIER", "observer");
+  const inactiveBidder = await account("CARRIER", "inactive");
+  const createdAt = Date.now();
+  const input = {
+    description: "  Pallets  ", pickupCity: "  New   York  ", pickupRegion: "ny", pickupLat: 40.7, pickupLng: -74,
+    deliveryCity: "Washington", deliveryRegion: " dc ", deliveryLat: 38.9, deliveryLng: -77,
+    pickupReadyAt: new Date(createdAt + 3600_000).toISOString(), deliveryBy: new Date(createdAt + 7200_000).toISOString(),
+  };
+  const emit = vi.spyOn(app, "emitToUser");
+  const create = (payload: object, headers = shipper.headers) => app.inject({ method: "POST", url, headers, payload });
+  expect((await create(input, bidder.headers)).statusCode).toBe(403);
+  expect((await create({ ...input, pickupRegion: "ZZ" })).statusCode).toBe(400);
+  expect((await create({ ...input, pickupLat: "40" })).statusCode).toBe(400);
+  expect((await create({ ...input, status: "OPEN" })).statusCode).toBe(400);
+  expect((await create({ ...input, deliveryBy: input.pickupReadyAt })).json().error.code).toBe("INVALID_LOAD_SCHEDULE");
+  const created = await create(input);
+  expect(created.statusCode, created.body).toBe(201);
+  const load = created.json().data;
+  expect(load).toMatchObject({ shipperId: shipper.id, status: "DRAFT", description: "Pallets", pickupCity: "New York", pickupRegion: "NY", deliveryRegion: "DC" });
+  const detail = `${url}/${load.id}`;
+  const get = (path: string, headers = shipper.headers) => app.inject({ url: path, headers });
+  const patch = (payload: object, headers = shipper.headers) => app.inject({ method: "PATCH", url: detail, headers, payload });
+  const action = (name: "publish" | "cancel") => app.inject({ method: "POST", url: `${detail}/${name}`, headers: shipper.headers });
+
+  expect((await get(detail, otherShipper.headers)).statusCode).toBe(404);
+  expect((await patch({ description: "changed" }, otherShipper.headers)).statusCode).toBe(404);
+  expect((await get(detail, admin.headers)).statusCode).toBe(200);
+  expect((await get(url, bidder.headers)).json().error.code).toBe("CARRIER_NOT_APPROVED");
+  expect((await get(`${url}?unknown=1`)).statusCode).toBe(400);
+  expect((await get(`${url}?limit=1`)).json()).toMatchObject({ data: [load], meta: { limit: 1, offset: 0, hasMore: false } });
+  expect((await get(url, otherShipper.headers)).json().data).toEqual([]);
+  expect((await patch({ deliveryBy: input.pickupReadyAt })).json().error.code).toBe("INVALID_LOAD_SCHEDULE");
+  expect((await patch({ description: " Revised pallets " })).json().data.description).toBe("Revised pallets");
+
+  for (const carrier of [bidder, observer, inactiveBidder]) {
+    await app.prisma.carrierProfile.update({ where: { id: carrier.profileId }, data: { verificationStatus: "APPROVED" } });
+  }
+  expect((await get(detail, bidder.headers)).statusCode).toBe(404);
+  expect((await action("publish")).json().data.status).toBe("OPEN");
+  expect((await action("publish")).json().error.code).toBe("LOAD_NOT_DRAFT");
+  expect((await patch({ description: "changed" })).json().error.code).toBe("LOAD_NOT_EDITABLE");
+  expect((await get(detail, bidder.headers)).statusCode).toBe(200);
+  expect((await get(`${url}?status=DRAFT`, bidder.headers)).json().data).toEqual([]);
+  expect((await get(`${url}?status=OPEN`, bidder.headers)).json().data).toContainEqual(expect.objectContaining({ id: load.id }));
+  expect(emit).not.toHaveBeenCalled();
+
+  const active = await app.prisma.bid.create({ data: { loadId: load.id, carrierProfileId: bidder.profileId!, currentRevision: 2 } });
+  const closed = await app.prisma.bid.create({ data: { loadId: load.id, carrierProfileId: inactiveBidder.profileId!, status: "CLOSED" } });
+  const cancellations = await Promise.all([action("cancel"), action("cancel")]);
+  for (const response of cancellations) expect(response.json().data.status).toBe("CANCELLED");
+  expect(cancellations[0].json().data).toEqual(cancellations[1].json().data);
+  expect(await app.prisma.bid.findUnique({ where: { id: active.id } })).toMatchObject({ status: "CLOSED", currentRevision: 2 });
+  expect(await app.prisma.bid.findUnique({ where: { id: closed.id } })).toEqual(closed);
+  expect(emit.mock.calls).toEqual([shipper.id, bidder.id].map((userId) => [userId, "bid:updated", {
+    loadId: load.id, bidId: active.id, status: "CLOSED", currentRevision: 2,
+  }]));
+  expect((await get(detail, bidder.headers)).statusCode).toBe(200);
+  expect((await get(detail, observer.headers)).statusCode).toBe(404);
+
+  const expired = await create({
+    ...input, pickupReadyAt: new Date(createdAt - 7200_000).toISOString(), deliveryBy: new Date(createdAt - 3600_000).toISOString(),
+  });
+  const expiredUrl = `${url}/${expired.json().data.id}`;
+  const publishExpired = await app.inject({ method: "POST", url: `${expiredUrl}/publish`, headers: shipper.headers, payload: {} });
+  expect(publishExpired.json().error.code).toBe("INVALID_LOAD_SCHEDULE");
+  const cancelDraft = await app.inject({ method: "POST", url: `${expiredUrl}/cancel`, headers: shipper.headers });
+  expect(cancelDraft.json().data.status).toBe("CANCELLED");
+  expect(emit).toHaveBeenCalledTimes(2);
+  emit.mockRestore();
+});
