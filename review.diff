@@ -0,0 +1,20 @@
+import type { Prisma } from "../../generated/prisma/client.js";
+
+export async function closeActiveBidsForLoad(tx: Prisma.TransactionClient, loadId: string) {
+  const closed = await tx.bid.updateManyAndReturn({
+    where: { loadId, status: "ACTIVE" }, data: { status: "CLOSED" }, select: { id: true },
+  });
+  return closed.map(({ id }) => id);
+}
+
+export async function carrierHasBidForLoad(db: Prisma.TransactionClient, loadId: string, carrierUserId: string) {
+  const bid = await db.bid.findFirst({ where: { loadId, carrierProfile: { userId: carrierUserId } }, select: { id: true } });
+  return bid !== null;
+}
+
+export function readClosedBidNotifications(tx: Prisma.TransactionClient, ids: string[]) {
+  return tx.bid.findMany({
+    where: { id: { in: ids } },
+    select: { id: true, currentRevision: true, carrierProfile: { select: { userId: true } } },
+  });
+}
diff --git a/apps/api/src/modules/carriers/routes.ts b/apps/api/src/modules/carriers/routes.ts
new file mode 100644
index 0000000..1dd0e46
--- /dev/null
+++ b/apps/api/src/modules/carriers/routes.ts
@@ -0,0 +1,100 @@
+import type { FastifyPluginAsync, FastifyReply, FastifyRequest } from "fastify";
+import { AppError } from "../../shared/errors.js";
+import { adminCarrier, adminQueue, dataResponse, emptyObject, errorResponses, insurance, profile, profileIdParams, profileInput, queueQuery, reviewInput } from "./schemas.js";
+import {
+  listAdminCarriers, openInsurance, readAdminCarrier, readOwnProfile, removeUnreferencedInsurance,
+  replaceInsurance, reviewCarrier, submitVerification, updateProfile,
+  type CarrierQuery, type ProfileInput, type ReviewInput,
+} from "./service.js";
+
+type ProfileParams = { carrierProfileId: string };
+
+function invalidInput(message = "The request is invalid.") {
+  return new AppError(400, "VALIDATION_ERROR", message);
+}
+
+async function normalizeCarrierInput(request: FastifyRequest) {
+  if (!request.body || typeof request.body !== "object" || Array.isArray(request.body)) throw invalidInput();
+  const fields = request.body as Record<string, unknown>;
+  for (const [name, value] of Object.entries(fields)) {
+    if (name === "expectedRevision" ? typeof value !== "number" : typeof value !== "string") throw invalidInput();
+  }
+  if (typeof fields.motorCarrierLicense === "string") fields.motorCarrierLicense = fields.motorCarrierLicense.trim().toUpperCase();
+  if (typeof fields.reviewNote === "string") fields.reviewNote = fields.reviewNote.trim();
+}
+
+function sendInsurance(reply: FastifyReply, file: Awaited<ReturnType<typeof openInsurance>>) {
+  return reply.type(file.mimeType)
+    .header("X-Content-Type-Options", "nosniff")
+    .header("Content-Disposition", "attachment")
+    .header("Cache-Control", "private, no-store")
+    .send(file.stream);
+}
+
+const fileResponses = { 200: { type: "string", format: "binary" }, ...errorResponses };
+
+export const carriersRoutes: FastifyPluginAsync = async (app) => {
+  const carrier = { onRequest: app.authenticate, preHandler: app.authorize("CARRIER") };
+  const admin = { onRequest: app.authenticate, preHandler: app.authorize("ADMIN") };
+
+  app.get("/carriers/me", { ...carrier, schema: { querystring: emptyObject, response: dataResponse(profile) } },
+    async (request) => ({ data: await readOwnProfile(app.prisma, request.user!) }));
+
+  app.patch<{ Body: ProfileInput }>("/carriers/me", {
+    ...carrier, preValidation: normalizeCarrierInput,
+    schema: { querystring: emptyObject, body: profileInput, response: dataResponse(profile) },
+  }, async (request) => ({ data: await updateProfile(app, request.user!, request.body) }));
+
+  app.put("/carriers/me/insurance", {
+    ...carrier,
+    schema: { consumes: ["multipart/form-data"], querystring: emptyObject, response: dataResponse(insurance) },
+  }, async (request) => {
+    let saved: Awaited<ReturnType<typeof app.uploads.save>> | undefined;
+    let invalid = false;
+    try {
+      for await (const part of request.parts()) {
+        if (part.type === "file" && part.fieldname === "file" && !saved) {
+          saved = await app.uploads.save("insurance", part.file);
+        } else {
+          invalid = true;
+          if (part.type === "file") part.file.resume();
+        }
+      }
+      if (!saved || invalid) throw invalidInput("Send exactly one insurance file in the file field.");
+      return { data: await replaceInsurance(app, request.user!, saved) };
+    } catch (error) {
+      if (saved) await removeUnreferencedInsurance(app, saved.storageKey);
+      const { FilesLimitError, FieldsLimitError, PartsLimitError } = app.multipartErrors;
+      if (error instanceof FilesLimitError || error instanceof FieldsLimitError || error instanceof PartsLimitError) {
+        throw invalidInput("Send exactly one insurance file in the file field.");
+      }
+      throw error;
+    }
+  });
+
+  app.get("/carriers/me/insurance", { ...carrier, schema: { querystring: emptyObject, response: fileResponses } },
+    async (request, reply) => sendInsurance(reply, await openInsurance(app, request.user!)));
+
+  app.post("/carriers/me/verification", {
+    ...carrier,
+    preValidation: async (request) => { if (request.body === undefined) request.body = {}; },
+    schema: { querystring: emptyObject, body: emptyObject, response: dataResponse(profile) },
+  }, async (request) => ({ data: await submitVerification(app, request.user!) }));
+
+  app.get<{ Querystring: CarrierQuery }>("/admin/carriers", {
+    ...admin, schema: { querystring: queueQuery, response: { 200: adminQueue, ...errorResponses } },
+  }, async (request) => listAdminCarriers(app.prisma, request.user!, request.query));
+
+  app.get<{ Params: ProfileParams }>("/admin/carriers/:carrierProfileId", {
+    ...admin, schema: { params: profileIdParams, querystring: emptyObject, response: dataResponse(adminCarrier) },
+  }, async (request) => ({ data: await readAdminCarrier(app.prisma, request.user!, request.params.carrierProfileId) }));
+
+  app.get<{ Params: ProfileParams }>("/admin/carriers/:carrierProfileId/insurance", {
+    ...admin, schema: { params: profileIdParams, querystring: emptyObject, response: fileResponses },
+  }, async (request, reply) => sendInsurance(reply, await openInsurance(app, request.user!, request.params.carrierProfileId)));
+
+  app.post<{ Params: ProfileParams; Body: ReviewInput }>("/admin/carriers/:carrierProfileId/review", {
+    ...admin, preValidation: normalizeCarrierInput,
+    schema: { params: profileIdParams, querystring: emptyObject, body: reviewInput, response: dataResponse(profile) },
+  }, async (request) => ({ data: await reviewCarrier(app, request.user!, request.params.carrierProfileId, request.body) }));
+};
diff --git a/apps/api/src/modules/carriers/schemas.ts b/apps/api/src/modules/carriers/schemas.ts
new file mode 100644
index 0000000..4627fb9
--- /dev/null
+++ b/apps/api/src/modules/carriers/schemas.ts
@@ -0,0 +1,50 @@
+import { VerificationStatus, SafetyRating } from "../../generated/prisma/enums.js";
+import { errorResponseSchema } from "../../shared/errors.js";
+import { userSchema } from "../users/schemas.js";
+
+function objectSchema<T extends Record<string, unknown>>(properties: T, required = Object.keys(properties)) {
+  return { type: "object", properties, required, additionalProperties: false } as const;
+}
+
+const uuid = { type: "string", format: "uuid", minLength: 36, maxLength: 36 } as const;
+const timestamp = { type: "string", format: "date-time" } as const;
+const integer = { type: "integer" } as const;
+const text = { type: "string" } as const;
+const status = { type: "string", enum: Object.values(VerificationStatus) } as const;
+const safetyRating = { type: "string", enum: Object.values(SafetyRating) } as const;
+const limit = { ...integer, minimum: 1, maximum: 100 };
+const offset = { ...integer, minimum: 0 };
+
+export const emptyObject = objectSchema({});
+export const profileIdParams = objectSchema({ carrierProfileId: uuid });
+export const queueQuery = objectSchema({ limit, offset, status }, []);
+export const profileInput = { ...objectSchema({
+  motorCarrierLicense: { ...text, minLength: 1, maxLength: 40 }, safetyRating,
+}, []), minProperties: 1 };
+
+export const reviewInput = {
+  ...objectSchema({
+    decision: { ...text, enum: ["APPROVED", "REJECTED"] },
+    expectedRevision: { ...integer, minimum: 1 },
+    reviewNote: { ...text, maxLength: 500 },
+  }, ["decision", "expectedRevision"]),
+  if: { properties: { decision: { const: "REJECTED" } } },
+  then: { required: ["reviewNote"], properties: { reviewNote: { type: "string", minLength: 1 } } },
+} as const;
+
+export const insurance = objectSchema({ id: uuid, mimeType: text, sizeBytes: integer, uploadedAt: timestamp });
+const nullable = (schema: object) => ({ anyOf: [schema, { type: "null" }] });
+export const profile = objectSchema({
+  id: uuid, userId: uuid, motorCarrierLicense: nullable(text), safetyRating: nullable(safetyRating),
+  verificationStatus: status, verificationRevision: integer, verificationSubmittedAt: nullable(timestamp),
+  reviewedByUserId: nullable(uuid), reviewedAt: nullable(timestamp), reviewNote: nullable(text), insurance: nullable(insurance),
+});
+
+export const adminCarrier = objectSchema({ carrierProfile: profile, user: userSchema });
+export const adminQueue = objectSchema({
+  data: { type: "array", items: adminCarrier },
+  meta: objectSchema({ limit, offset, hasMore: { type: "boolean" } }),
+});
+
+export const errorResponses = { "4xx": errorResponseSchema, "5xx": errorResponseSchema };
+export const dataResponse = (data: object) => ({ 200: objectSchema({ data }), ...errorResponses });
diff --git a/apps/api/src/modules/carriers/service.ts b/apps/api/src/modules/carriers/service.ts
index 7d669d0..0e5e9d9 100644
--- a/apps/api/src/modules/carriers/service.ts
+++ b/apps/api/src/modules/carriers/service.ts
@@ -1,5 +1,211 @@
-import type { Prisma } from "../../generated/prisma/client.js";
+import type { FastifyInstance } from "fastify";
+import { Prisma, type Role, type SafetyRating, type VerificationStatus } from "../../generated/prisma/client.js";
+import type { AuthenticatedUser } from "../../plugins/auth.js";
+import { AppError, errorContext } from "../../shared/errors.js";
+import { withSerializableTransaction } from "../../shared/transactions.js";
+import { toUserDto } from "../users/service.js";
+
+export type ProfileInput = { motorCarrierLicense?: string; safetyRating?: SafetyRating };
+export type ReviewInput = { decision: "APPROVED" | "REJECTED"; expectedRevision: number; reviewNote?: string };
+export type CarrierQuery = { limit?: number; offset?: number; status?: VerificationStatus };
+
+const includeInsurance = { insurance: true } as const;
+const includeAccount = {
+  ...includeInsurance,
+  user: { select: { id: true, email: true, displayName: true, role: true, createdAt: true } },
+} as const;
+type Profile = Prisma.CarrierProfileGetPayload<{ include: typeof includeInsurance }>;
+type Document = NonNullable<Profile["insurance"]>;
+type SavedInsurance = Awaited<ReturnType<FastifyInstance["uploads"]["save"]>>;
+
+function requireRole(user: AuthenticatedUser, role: Role) {
+  if (user.role !== role) throw new AppError(403, "FORBIDDEN", "This action is unavailable to your role.");
+}
+
+function notFound() {
+  return new AppError(404, "NOT_FOUND", "The requested resource was not found.");
+}
+
+function requireEditable(profile: Profile) {
+  if (profile.verificationStatus !== "DRAFT" && profile.verificationStatus !== "REJECTED") {
+    throw new AppError(409, "PROFILE_LOCKED", "The carrier profile is locked for editing.");
+  }
+}
+
+async function ownProfile(db: Prisma.TransactionClient, user: AuthenticatedUser) {
+  requireRole(user, "CARRIER");
+  const profile = await db.carrierProfile.findUnique({ where: { userId: user.id }, include: includeInsurance });
+  if (!profile) throw notFound();
+  return profile;
+}
+
+function toInsuranceDto({ id, mimeType, sizeBytes, uploadedAt }: Document) {
+  return { id, mimeType, sizeBytes, uploadedAt: uploadedAt.toISOString() };
+}
+
+function toProfileDto(profile: Profile) {
+  const { insurance, verificationSubmittedAt, reviewedAt, ...fields } = profile;
+  return {
+    ...fields,
+    verificationSubmittedAt: verificationSubmittedAt?.toISOString() ?? null,
+    reviewedAt: reviewedAt?.toISOString() ?? null,
+    insurance: insurance ? toInsuranceDto(insurance) : null,
+  };
+}
+
+function toAdminCarrierDto({ user, ...profile }: Prisma.CarrierProfileGetPayload<{ include: typeof includeAccount }>) {
+  return { carrierProfile: toProfileDto(profile), user: toUserDto(user) };
+}
+
+function emitVerification(app: FastifyInstance, profile: Profile) {
+  app.emitToUser(profile.userId, "carrier:verificationChanged", {
+    carrierProfileId: profile.id, verificationStatus: profile.verificationStatus,
+  });
+}
 
 export async function createDraftProfile(tx: Prisma.TransactionClient, userId: string) {
   await tx.carrierProfile.create({ data: { userId, verificationStatus: "DRAFT" } });
 }
+
+export async function isCarrierApproved(db: Prisma.TransactionClient, userId: string) {
+  const profile = await db.carrierProfile.findUnique({ where: { userId }, select: { verificationStatus: true } });
+  return profile?.verificationStatus === "APPROVED";
+}
+
+export async function readOwnProfile(db: Prisma.TransactionClient, user: AuthenticatedUser) {
+  return toProfileDto(await ownProfile(db, user));
+}
+
+export async function updateProfile(app: FastifyInstance, user: AuthenticatedUser, input: ProfileInput) {
+  try {
+    const updated = await withSerializableTransaction(app.prisma, async (tx) => {
+      const profile = await ownProfile(tx, user);
+      requireEditable(profile);
+      return tx.carrierProfile.update({ where: { id: profile.id }, data: input, include: includeInsurance });
+    });
+    return toProfileDto(updated);
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === "P2002") {
+      throw new AppError(409, "LICENSE_IN_USE", "That motor carrier license is already in use.");
+    }
+    throw error;
+  }
+}
+
+export async function removeUnreferencedInsurance(app: FastifyInstance, storageKey: string) {
+  try {
+    const reference = await app.prisma.carrierDocument.findUnique({ where: { storageKey }, select: { id: true } });
+    if (!reference) await app.uploads.remove(storageKey);
+  } catch (error) {
+    app.log.warn({ failure: errorContext(error) }, "Could not clean up an insurance file");
+  }
+}
+
+export async function replaceInsurance(app: FastifyInstance, user: AuthenticatedUser, saved: SavedInsurance) {
+  const { storageKey, mimeType, sizeBytes } = saved;
+  const { document, priorKey } = await withSerializableTransaction(app.prisma, async (tx) => {
+    const profile = await ownProfile(tx, user);
+    requireEditable(profile);
+    // Serialize replacements even when there is no document row yet.
+    await tx.carrierProfile.update({ where: { id: profile.id }, data: { verificationStatus: profile.verificationStatus } });
+    if (profile.insurance) await tx.carrierDocument.delete({ where: { id: profile.insurance.id } });
+    const document = await tx.carrierDocument.create({
+      data: { carrierProfileId: profile.id, storageKey, mimeType, sizeBytes },
+    });
+    return { document, priorKey: profile.insurance?.storageKey };
+  });
+  if (priorKey) await removeUnreferencedInsurance(app, priorKey);
+  return toInsuranceDto(document);
+}
+
+export async function openInsurance(app: FastifyInstance, user: AuthenticatedUser, carrierProfileId?: string) {
+  const profile = carrierProfileId === undefined
+    ? await ownProfile(app.prisma, user)
+    : await adminProfile(app.prisma, user, carrierProfileId);
+  if (!profile.insurance) throw notFound();
+  return { mimeType: profile.insurance.mimeType, stream: await app.uploads.open(profile.insurance.storageKey) };
+}
+
+export async function submitVerification(app: FastifyInstance, user: AuthenticatedUser) {
+  // Insurance can be replaced between checking the file and starting the transaction.
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const candidate = await ownProfile(app.prisma, user);
+    requireEditable(candidate);
+    const storageKey = candidate.insurance?.storageKey;
+    let fileAvailable = false;
+    if (storageKey) {
+      try {
+        const stream = await app.uploads.open(storageKey);
+        stream.destroy();
+        fileAvailable = true;
+      } catch (error) {
+        if (!(error instanceof AppError) || error.code !== "FILE_UNAVAILABLE") throw error;
+      }
+    }
+
+    const submitted = await withSerializableTransaction(app.prisma, async (tx) => {
+      const profile = await ownProfile(tx, user);
+      requireEditable(profile);
+      if (storageKey !== profile.insurance?.storageKey) return null;
+      if (!profile.motorCarrierLicense || !profile.safetyRating || !fileAvailable) {
+        throw new AppError(422, "VERIFICATION_INCOMPLETE", "A license, safety rating and insurance certificate are required.");
+      }
+      return tx.carrierProfile.update({
+        where: { id: profile.id },
+        include: includeInsurance,
+        data: {
+          verificationStatus: "PENDING", verificationRevision: { increment: 1 }, verificationSubmittedAt: new Date(),
+          reviewedByUserId: null, reviewedAt: null, reviewNote: null,
+        },
+      });
+    });
+    if (submitted) {
+      emitVerification(app, submitted);
+      return toProfileDto(submitted);
+    }
+  }
+  throw new AppError(503, "CONCURRENT_UPDATE", "The resource changed concurrently. Try again.");
+}
+
+async function adminProfile(db: Prisma.TransactionClient, user: AuthenticatedUser, id: string) {
+  requireRole(user, "ADMIN");
+  const profile = await db.carrierProfile.findUnique({ where: { id }, include: includeAccount });
+  if (!profile) throw notFound();
+  return profile;
+}
+
+export async function readAdminCarrier(db: Prisma.TransactionClient, user: AuthenticatedUser, id: string) {
+  return toAdminCarrierDto(await adminProfile(db, user, id));
+}
+
+export async function listAdminCarriers(db: Prisma.TransactionClient, user: AuthenticatedUser, query: CarrierQuery) {
+  requireRole(user, "ADMIN");
+  const { limit = 20, offset = 0, status = "PENDING" } = query;
+  const rows = await db.carrierProfile.findMany({
+    where: { verificationStatus: status }, include: includeAccount,
+    orderBy: [{ verificationSubmittedAt: { sort: "desc", nulls: "last" } }, { id: "desc" }],
+    skip: offset, take: limit + 1,
+  });
+  return { data: rows.slice(0, limit).map(toAdminCarrierDto), meta: { limit, offset, hasMore: rows.length > limit } };
+}
+
+export async function reviewCarrier(app: FastifyInstance, user: AuthenticatedUser, id: string, input: ReviewInput) {
+  const reviewed = await withSerializableTransaction(app.prisma, async (tx) => {
+    const profile = await adminProfile(tx, user, id);
+    if (profile.verificationStatus !== "PENDING") {
+      throw new AppError(409, "VERIFICATION_NOT_PENDING", "The carrier submission is no longer pending.");
+    }
+    if (profile.verificationRevision !== input.expectedRevision) {
+      throw new AppError(409, "STALE_VERIFICATION", "The carrier has a newer pending submission.");
+    }
+    return tx.carrierProfile.update({
+      where: { id }, include: includeInsurance,
+      data: {
+        verificationStatus: input.decision, reviewedByUserId: user.id, reviewedAt: new Date(),
+        reviewNote: input.reviewNote ?? null,
+      },
+    });
+  });
+  emitVerification(app, reviewed);
+  return toProfileDto(reviewed);
+}
