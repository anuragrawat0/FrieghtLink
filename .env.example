# Local development database credentials. Use a URL-safe password for Compose.
POSTGRES_DB=freightlink
POSTGRES_USER=freightlink
POSTGRES_PASSWORD=replace_with_url_safe_dev_password
POSTGRES_PORT=5432
# Host-side Prisma and API use this URL. Compose sets its own URL using db:5432.
DATABASE_URL=postgresql://freightlink:replace_with_url_safe_dev_password@localhost:5432/freightlink?schema=public

HOST=127.0.0.1
PORT=3001
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
# Replace with 32 random bytes encoded as hex before starting the API.
JWT_SECRET=
UPLOAD_DIR=./uploads

# Optional, test mode only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reserved for future demo seeding.
DEMO_ADMIN_EMAIL=admin@example.invalid
DEMO_ADMIN_PASSWORD=

# Separate database used only by the integration suite.
TEST_POSTGRES_PASSWORD=replace_with_url_safe_test_password
TEST_POSTGRES_PORT=55433
TEST_DATABASE_URL=postgresql://freightlink_test:replace_with_url_safe_test_password@127.0.0.1:55433/freightlink_test?schema=public
