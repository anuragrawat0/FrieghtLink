{
  "name": "@freightlink/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && npm run --silent db:prepare && tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "npm run --silent db:prepare && node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && vitest run --project unit",
    "test:db": "prisma generate && vitest run --project database",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:prepare": "npm run --silent db:deploy && node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
